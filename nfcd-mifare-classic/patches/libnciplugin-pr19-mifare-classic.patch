+ * timeout, not a hard ceiling: nci_adapter_renew_mifare_timeout() resets
+ * it on every real exchange, so it only fires once the tag actually goes
+ * quiet.
+ */
+#define MIFARE_TAG_TIMEOUT_SEC (8)
